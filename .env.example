# Local Postgres in Docker (docker-compose.yml, roadmap step 2.2). See docs/database.md.
# Choose a password of letters and digits only (no symbols, so the address below needs no escaping),
# put it in BOTH lines, and never commit this file.
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://laluan:PUT_THE_SAME_PASSWORD_HERE@127.0.0.1:5432/laluan?schema=public"

# Development-only shared demo key, never production authentication.
DEMO_OPERATOR_KEY="replace-with-private-dev-key"

# AI provider: use local Ollama by default (no pay-per-request usage).
AI_PROVIDER="ollama"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional cloud alternative, separately billed. Never commit a real API key.
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_EMBED_MODEL="text-embedding-3-small"

# Service area (where reports are accepted). Default: bbr (config/service-areas/bbr.geojson).
# For your own test area, copy config/service-areas/local.example.geojson to local.geojson,
# edit it, then uncomment the next line and restart the dev server. Server-only setting.
# SERVICE_AREA="local"

# Way home (roadmap phase 6): routes come from OpenRouteService (free key from openrouteservice.org).
# The key stays on the server. Without it, the way-home card says it is not set up yet. Never commit a real key.
# OPENROUTESERVICE_API_KEY=""
# ROUTING_PROVIDER="local"   # "local" = your area's own road lines, no key (default without a key);
#                             "openrouteservice", "recorded" (one fictional BBR trip, for tests) or "off"
