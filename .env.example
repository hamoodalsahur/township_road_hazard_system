# Local SQLite demo database. Prisma resolves this path relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Development-only shared demo key, never production authentication.
DEMO_OPERATOR_KEY="replace-with-private-dev-key"

# AI provider: use local Ollama by default (no pay-per-request usage).
AI_PROVIDER="ollama"
OLLAMA_EMBED_MODEL="nomic-embed-text"

# Optional cloud alternative, separately billed. Never commit a real API key.
# AI_PROVIDER="openai"
# OPENAI_API_KEY=""
# OPENAI_EMBED_MODEL="text-embedding-3-small"

# Service area (where reports are accepted). Default: bbr (config/service-areas/bbr.geojson).
# For your own test area, copy config/service-areas/local.example.geojson to local.geojson,
# edit it, then uncomment the next line and restart the dev server. Server-only setting.
# SERVICE_AREA="local"
